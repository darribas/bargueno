{
  "name": "bargueno",
  "version": "0.1.0",
  "description": "Bargueño: the writing-studio plugins (Typst preview, exports, kernel policy).",
  "license": "BSD-3-Clause",
  "private": true,
  "keywords": [
    "jupyterlab-extension"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "files": [
    "lib/**/*.js",
    "style/**/*.css",
    "schema/*.json"
  ],
  "scripts": {
    "build": "tsc && jupyter labextension build .",
    "build:lib": "tsc",
    "clean": "rm -rf lib labextension tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.6.4",
    "@jupyterlab/apputils": "^4.6.4",
    "@jupyterlab/coreutils": "^6.6.4",
    "@jupyterlab/docregistry": "^4.6.4",
    "@jupyterlab/filebrowser": "^4.6.4",
    "@jupyterlab/fileeditor": "^4.6.4",
    "@jupyterlab/notebook": "^4.6.4",
    "@jupyterlab/services": "^7.6.4",
    "@jupyterlab/statusbar": "^4.6.4",
    "@jupyterlab/ui-components": "^4.6.4",
    "@lumino/coreutils": "^2.2.3",
    "@lumino/disposable": "^2.1.0",
    "@lumino/signaling": "^2.1.6",
    "@lumino/widgets": "^2.7.0",
    "@myriaddreamin/typst-ts-renderer": "0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "fflate": "0.8.3",
    "js-yaml": "4.1.1",
    "myst-parser": "1.7.4",
    "myst-to-typst": "0.0.39",
    "myst-transforms": "1.3.51",
    "unified": "^10.1.2",
    "vfile": "^5.3.7"
  },
  "devDependencies": {
    "@jupyterlab/builder": "4.5.11",
    "@types/js-yaml": "^4.0.9",
    "@typst-wasm/fonts": "1.0.0",
    "typescript": "~5.9.3"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "labextension",
    "schemaDir": "schema"
  }
}
